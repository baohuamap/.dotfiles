# alias for zsh
#

alias cls=clear
alias vim=nvim

alias ll="eza -l -g --icons"
alias lla="ll -a"

# alias for python venv
alias venv="if [ -e ./.venv/bin/activate ]; then source ./.venv/bin/activate; else python3.8 -m venv .venv && source ./.venv/bin/activate; fi"
alias venv3.7="if [ -e ./.venv/bin/activate ]; then source ./.venv/bin/activate; else python3.7 -m venv .venv && source ./.venv/bin/activate; fi"

